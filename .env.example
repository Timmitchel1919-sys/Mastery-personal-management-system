# ─────────────────────────────────────────────────────────────
# Mastery — environment variables
# Copy to `.env.local` for local development. Never commit real values.
# Every variable here is parsed and validated by `src/lib/env.ts`.
# ─────────────────────────────────────────────────────────────

# Application environment. One of: development | test | staging | production
NEXT_PUBLIC_APP_ENV=development

# Public base URL of the app (used for absolute links / metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Added in later layers ────────────────────────────────────
# Layer 3  (Firebase Foundation):  NEXT_PUBLIC_FIREBASE_* web config + emulator flags
# Layer 13 (General AI Architecture): server-side AI provider credentials (Functions secrets)
