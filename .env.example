# ─────────────────────────────────────────────────────────────
# Mastery — environment variables
# Copy to `.env.local` for local development. Never commit real values.
# Every NEXT_PUBLIC_* variable is parsed and validated by `src/lib/env.ts`.
# ─────────────────────────────────────────────────────────────

# Application environment. One of: development | test | staging | production
NEXT_PUBLIC_APP_ENV=development

# Public base URL of the app (used for absolute links / metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Firebase (Layer 3) ───────────────────────────────────────
# Web SDK config from the Firebase console → Project settings → Your apps.
# These are project identifiers, not secrets, but stay environment-scoped.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Set to "true" to route the client + admin SDKs to the local Emulator Suite
# (started with `npm run emulators`). Ports mirror firebase.json.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ── App Check (Layer 20) ─────────────────────────────────────
# reCAPTCHA v3 site key (Firebase console → App Check → Apps → reCAPTCHA v3).
# When set, the web SDK attests every Firestore/Storage/Functions request.
# Leave blank to skip App Check init; enforcement is toggled in the console.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# ── Server-only secrets (never prefixed NEXT_PUBLIC) ──────────
# Firebase Admin credentials for non-emulator server runtimes that lack
# Application Default Credentials. Paste the service-account JSON on one line.
# On Firebase App Hosting this is not needed (ADC is provided).
# FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}

# AI provider credentials are added in Layer 13 (Functions secrets, not here).
