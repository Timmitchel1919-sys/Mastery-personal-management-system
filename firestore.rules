rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Owner-only access to users/{uid}/**.
//
// Layer 4:
// * A signed-in user reads/writes only their own data.
// * `role` is fixed to "user" on create and immutable from the client
//   afterwards — privilege elevation only ever happens via trusted
//   server-issued custom claims.
// * `id` / `createdAt` / `createdBy` are immutable; `updatedBy` must be the
//   caller. `users` is not listable (no enumerating accounts). No client delete.
//
// Layer 6:
// * Every subcollection record must carry audit fields: `createdBy`/`updatedBy`
//   equal the caller on create; `createdBy`/`createdAt` immutable and
//   `updatedBy` = caller on update. Per-field domain validation and Recovery
//   Center hardening (server-mediated writes) come in Layer 15 / Layer 20.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The user profile document itself — narrow, field-validated rules.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && request.resource.data.id == uid
        && request.resource.data.role == 'user'
        && request.resource.data.createdBy == uid
        && request.resource.data.updatedBy == uid
        && request.resource.data.status == 'active';

      allow update: if isOwner(uid)
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == uid;

      allow delete: if false;
    }

    // Owned subcollections. The explicit {collection} segment keeps this from
    // matching the users/{uid} profile document above.
    //
    // Layer 15A: `recoveryProfiles` (the Recovery Center PIN lock config) and 15B's
    // `recoveryGoals` / `recoveryGoals/*/checkIns` are ordinary client-writable
    // owner-only data, covered here.
    //
    // Layer 15C: recovery *setback* records are Cloud-Function-mediated per
    // `docs/RECOVERY_PRIVACY.md` §3 — the Admin SDK bypasses rules entirely, so
    // refusing a direct client write here makes `recordRecoverySetback` the only
    // writer. `document` under the recursive wildcard is the sub-path after
    // {collection}; a relapse doc is `.../relapses/{id}`. Firestore ORs every matching
    // rule, so this guard lives in the wildcard itself, not a separate block.
    // Coach sessions (15E) and accountability config (15F) will extend this guard.
    function isServerMediatedRecoveryWrite(document) {
      return string(document).matches('(^|.*/)relapses/[^/]+$');
    }

    match /users/{uid}/{collection}/{document=**} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && !isServerMediatedRecoveryWrite(document)
        && request.resource.data.createdBy == uid
        && request.resource.data.updatedBy == uid;

      allow update: if isOwner(uid)
        && !isServerMediatedRecoveryWrite(document)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == uid;

      allow delete: if isOwner(uid)
        && !isServerMediatedRecoveryWrite(document);
    }
  }
}
