rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Owner-only access to users/{uid}/**.
//
// Layer 4:
// * A signed-in user reads/writes only their own data.
// * `role` is fixed to "user" on create and immutable from the client
//   afterwards — privilege elevation only ever happens via trusted
//   server-issued custom claims.
// * `id` / `createdAt` / `createdBy` are immutable; `updatedBy` must be the
//   caller. `users` is not listable (no enumerating accounts). No client delete.
//
// Layer 6:
// * Every subcollection record must carry audit fields: `createdBy`/`updatedBy`
//   equal the caller on create; `createdBy`/`createdAt` immutable and
//   `updatedBy` = caller on update. Per-field domain validation and Recovery
//   Center hardening (server-mediated writes) come in Layer 15 / Layer 20.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The user profile document itself — narrow, field-validated rules.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && request.resource.data.id == uid
        && request.resource.data.role == 'user'
        && request.resource.data.createdBy == uid
        && request.resource.data.updatedBy == uid
        && request.resource.data.status == 'active';

      allow update: if isOwner(uid)
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == uid;

      allow delete: if false;
    }

    // Owned subcollections. The explicit {collection} segment keeps this from
    // matching the users/{uid} profile document above.
    //
    // Layer 15A: `recoveryProfiles` (the Recovery Center's PIN lock config) is
    // currently covered by this same generic rule — fully client-writable, which is
    // correct for a lock config that holds no relapse/coach/accountability data. A
    // later sublayer that adds a recovery collection needing Cloud-Function-only
    // writes (relapses ~15C, coach sessions ~15E, accountability config ~15F) must
    // restructure this match to exclude that collection name (Firestore ORs every
    // matching rule together, so a narrower `match` block alone cannot override this
    // wildcard) rather than relying on a second, more-permissive rule staying silent.
    match /users/{uid}/{collection}/{document=**} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.createdBy == uid
        && request.resource.data.updatedBy == uid;

      allow update: if isOwner(uid)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == uid;

      allow delete: if isOwner(uid);
    }
  }
}
