rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Layer 4 — owner-only Storage under users/{uid}/**.
//
// * Read/write only your own path.
// * Uploads limited to images and PDFs, max 10 MB.
// * Everything outside users/{uid}/** is denied.
// Layer 20 review: no feature stores user files in Storage yet, so this owner-only +
// type + size gate is the whole surface. When an upload feature lands it must scope to a
// known prefix (e.g. users/{uid}/uploads/**) and validate per-feature there.
// ─────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)|application/pdf');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
